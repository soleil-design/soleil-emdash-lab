{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "soleil-emdash-lab",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "soleil-emdash-lab-db","database_id": "6ae84700-4743-4b31-8f52-bb20e30fb598",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "soleil-emdash-lab-media","preview_bucket_name": "soleil-emdash-lab-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
